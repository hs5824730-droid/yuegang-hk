{
  "name": "australia-property-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "review:local": "tsx scripts/signal-local-review.ts",
    "test:signal-relay": "node --disable-warning=ExperimentalWarning --test signal-relay/test.mjs",
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:lan": "node scripts/dev-lan.mjs",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:com": "node scripts/build-cloudflare.mjs com",
    "build:net": "node scripts/build-cloudflare.mjs net",
    "deploy:com": "wrangler deploy --config wrangler.jsonc",
    "deploy:net": "wrangler deploy --config wrangler.net.jsonc",
    "start": "tsx server/index.ts",
    "test": "tsx --test server/*.test.ts",
    "admin:create": "tsx server/create-admin.ts",
    "data:import": "tsx server/import-properties.ts",
    "data:backup": "tsx server/backup.ts",
    "test:browser:server": "tsx server/browser-fixture.ts",
    "cf:types": "wrangler types worker-configuration.d.ts --strict-vars false --env-file .dev.vars.example",
    "cf:typecheck": "npm run cf:types && tsc -p tsconfig.worker.json",
    "cf:dev": "wrangler dev --local --env-file .dev.vars",
    "cf:migrate:local": "wrangler d1 migrations apply DB --local --env-file .dev.vars.example",
    "cf:dry-run": "wrangler deploy --dry-run --outdir .worker-build --env-file .dev.vars.example",
    "build:cloudflare": "npm run cf:typecheck && npm run build && npm run cf:dry-run",
    "cf:export": "node scripts/export-cloudflare-data.mjs",
    "review:direct-contact": "tsx scripts/direct-contact-local-review.ts"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@radix-ui/colors": "^3.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "three": "^0.186.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261019.2-beta",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "wrangler": "^4.152.0"
  }
}
