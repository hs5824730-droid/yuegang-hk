MAIL_SEND_ENABLED=false
MAIL_START_AT=
ZOHO_ACCOUNT_ID=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Public contact is callback-only; keep legacy direct allocation disabled.
