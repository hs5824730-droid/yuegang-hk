{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "harbour-joy",
  "account_id": "b65685ed0ee606d73747149aff303600",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // Harbour Joy has no domain yet; add its own routes here. Never reuse eucove.com.
  "routes": [],
  "send_metrics": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "harbour-joy",
    "database_id": "REPLACE-WITH-HARBOUR-JOY-D1-ID",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "harbour-joy-media" }],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "PUBLIC_DIRECT_CONTACT_ENABLED": "false",
    "APP_URL": "https://example.invalid",
    "BRAND_ZH": "悦港",
    "BRAND_EN": "Harbour Joy",
    "WHATSAPP_NUMBER": "",
    "DISABLE_TELEGRAM": "false",
    "SIGNAL_ENABLED": "true",
    "MAIL_ENABLED": "true",
    "MAIL_SEND_ENABLED": "true",
    "MAIL_START_AT": "2026-10-26T13:56:13.958Z",
    "REGISTRATION_SHEETS_ENABLED": "false",
    "REGISTRATION_SHEETS_ID": "17qZqF0GvUsK4X9L_31uQvDwC1rUNGyXTgRy8aISddh0",
    "REGISTRATION_SHEETS_TAB": "房东登记",
    "TURNSTILE_ENABLED": "false"
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 1 },
    // Telegram Bot API embeds credentials in its path. Do not persist automatic outbound URL spans.
    "traces": { "enabled": true, "head_sampling_rate": 0.1, "persist": false }
  }
}
